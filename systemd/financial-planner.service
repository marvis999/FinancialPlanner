[Unit]
Description=Financial Planner web app (127.0.0.1:3210)

[Service]
Type=simple
WorkingDirectory=@REPO@
# The mise shims put node, npm and the Claude CLI (import review, analysis) on PATH.
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Loopback only: the app has no login, and the host check alone trusts a
# Host header that any machine on the network can fake.
ExecStart=%h/.local/share/mise/shims/npm start -- -H 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
