# Only needed for the optional Claude features in Docker, and only together
# with docker-compose.claude.yml. Copy this file to `.env` and set the path to
# the directory that holds your `.claude` folder and `.claude.json` file.
#
#   Linux / macOS      CLAUDE_HOME=/home/you      (or /Users/you)
#   Windows            CLAUDE_HOME=C:/Users/you
#
# Use forward slashes on Windows. Docker Compose does not expand `~` or `$HOME`
# here, so write the path out in full.
CLAUDE_HOME=
